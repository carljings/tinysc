<?xml version="1.0" encoding="UTF-8"?>
<web-app xmlns="http://xmlns.jcp.org/xml/ns/javaee"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://xmlns.jcp.org/xml/ns/javaee http://xmlns.jcp.org/xml/ns/javaee/web-app_3_1.xsd"
         version="3.1"
         metadata-complete="true">
    <listener>
        <listener-class>example.tinysc.probe.ProbeListener</listener-class>
    </listener>

    <filter>
        <filter-name>probeFilter</filter-name>
        <filter-class>example.tinysc.probe.ProbeFilter</filter-class>
        <async-supported>true</async-supported>
    </filter>
    <filter>
        <filter-name>errorDispatchFilter</filter-name>
        <filter-class>example.tinysc.probe.ErrorDispatchFilter</filter-class>
    </filter>
    <filter-mapping>
        <filter-name>probeFilter</filter-name>
        <url-pattern>/*</url-pattern>
        <dispatcher>REQUEST</dispatcher>
        <dispatcher>FORWARD</dispatcher>
    </filter-mapping>
    <filter-mapping>
        <filter-name>errorDispatchFilter</filter-name>
        <url-pattern>/*</url-pattern>
        <dispatcher>ERROR</dispatcher>
    </filter-mapping>

    <servlet>
        <servlet-name>probeServlet</servlet-name>
        <servlet-class>example.tinysc.probe.ProbeServlet</servlet-class>
        <load-on-startup>1</load-on-startup>
    </servlet>
    <servlet-mapping>
        <servlet-name>probeServlet</servlet-name>
        <url-pattern>/hello/*</url-pattern>
    </servlet-mapping>

    <servlet>
        <servlet-name>asyncProbeServlet</servlet-name>
        <servlet-class>example.tinysc.probe.AsyncProbeServlet</servlet-class>
        <async-supported>true</async-supported>
    </servlet>
    <servlet-mapping>
        <servlet-name>asyncProbeServlet</servlet-name>
        <url-pattern>/async</url-pattern>
    </servlet-mapping>

    <servlet>
        <servlet-name>forwardProbeServlet</servlet-name>
        <servlet-class>example.tinysc.probe.ForwardProbeServlet</servlet-class>
    </servlet>
    <servlet-mapping>
        <servlet-name>forwardProbeServlet</servlet-name>
        <url-pattern>/forward</url-pattern>
    </servlet-mapping>

    <servlet>
        <servlet-name>uploadProbeServlet</servlet-name>
        <servlet-class>example.tinysc.probe.UploadProbeServlet</servlet-class>
        <multipart-config>
            <max-file-size>64</max-file-size>
            <max-request-size>1024</max-request-size>
            <file-size-threshold>0</file-size-threshold>
        </multipart-config>
    </servlet>
    <servlet-mapping>
        <servlet-name>uploadProbeServlet</servlet-name>
        <url-pattern>/upload</url-pattern>
    </servlet-mapping>

    <servlet>
        <servlet-name>annotatedUploadProbeServlet</servlet-name>
        <servlet-class>example.tinysc.probe.UploadProbeServlet</servlet-class>
    </servlet>
    <servlet-mapping>
        <servlet-name>annotatedUploadProbeServlet</servlet-name>
        <url-pattern>/annotated-upload</url-pattern>
    </servlet-mapping>

    <servlet>
        <servlet-name>emptyConfigUploadProbeServlet</servlet-name>
        <servlet-class>example.tinysc.probe.UploadProbeServlet</servlet-class>
        <multipart-config/>
    </servlet>
    <servlet-mapping>
        <servlet-name>emptyConfigUploadProbeServlet</servlet-name>
        <url-pattern>/empty-config-upload</url-pattern>
    </servlet-mapping>

    <servlet>
        <servlet-name>benchmarkServlet</servlet-name>
        <servlet-class>example.tinysc.probe.BenchmarkServlet</servlet-class>
        <load-on-startup>2</load-on-startup>
    </servlet>
    <servlet-mapping>
        <servlet-name>benchmarkServlet</servlet-name>
        <url-pattern>/benchmark</url-pattern>
    </servlet-mapping>

    <servlet>
        <servlet-name>errorEntryServlet</servlet-name>
        <servlet-class>example.tinysc.probe.ErrorEntryServlet</servlet-class>
    </servlet>
    <servlet-mapping>
        <servlet-name>errorEntryServlet</servlet-name>
        <url-pattern>/error/*</url-pattern>
    </servlet-mapping>

    <servlet>
        <servlet-name>errorViewServlet</servlet-name>
        <servlet-class>example.tinysc.probe.ErrorViewServlet</servlet-class>
    </servlet>
    <servlet-mapping>
        <servlet-name>errorViewServlet</servlet-name>
        <url-pattern>/errors/*</url-pattern>
    </servlet-mapping>

    <session-config>
        <session-timeout>5</session-timeout>
    </session-config>
    <welcome-file-list>
        <welcome-file>index.html</welcome-file>
    </welcome-file-list>

    <error-page>
        <error-code>404</error-code>
        <location>/errors/status-404</location>
    </error-page>
    <error-page>
        <exception-type>java.lang.RuntimeException</exception-type>
        <location>/errors/runtime-exception</location>
    </error-page>
    <error-page>
        <exception-type>java.io.IOException</exception-type>
        <location>/errors/io-root-cause</location>
    </error-page>
    <error-page>
        <exception-type>java.lang.UnsupportedOperationException</exception-type>
        <location>/errors/failing-error-page</location>
    </error-page>
    <error-page>
        <error-code>500</error-code>
        <location>/errors/status-500</location>
    </error-page>
    <error-page>
        <location>/errors/default</location>
    </error-page>
</web-app>
